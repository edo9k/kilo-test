<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera & Storage permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.camera"
        android:required="true" />
    <uses-feature
        android:name="android.microphone"
        android:required="false" />

    <application
        android:name=".MotionGuardApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.MotionGuard"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".cloud.CloudConfigActivity"
            android:exported="false"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".cloud.UploadHistoryActivity"
            android:exported="false"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:screenOrientation="fullUser" />

        <service
            android:name=".camera.RecordingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|mediaProjection|dataSync"
            android:permission="android.permission.BIND_SERVICE" />

        <service
            android:name=".storage.CloudUploadWorker"
            android:exported="false"
            android:permission="android.permission.BIND_SERVICE" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_name"
            android:value="@string/notification_channel_name" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true"
            android:meta-data="@xml/file_paths" />

    </application>
</manifest>